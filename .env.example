# Django settings
SECRET_KEY=YOUR_SECRET_KEY
DEBUG=False

# Production hosts (comma-separated, no spaces)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# CSRF trusted origins (comma-separated, no spaces)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# PostgreSQL Database (used in production)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/latexgenius
# Docker Compose PostgreSQL (for docker-compose.prod.yml)
DB_NAME=latexgenius
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD


# Email settings (set SMTP backend in production)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@example.com
# EMAIL_HOST_PASSWORD=your_email_password
# DEFAULT_FROM_EMAIL=noreply@latexgenius.com

# LaTeX Compiler Settings
# For local development with docker-compose use http://latex-online:2700/compile
LATEX_COMPILER_URL=https://latexonline.cc/compile

# Kimi (Moonshot AI via NVIDIA) API Key
KIMI_API_KEY=YOUR_KIMI_API_KEY
KIMI_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
KIMI_MODEL=moonshotai/kimi-k2.6

# Google API Key (used by some external client libraries)
# X_GOOGLE_API_KEY=your_google_api_key_here

# Social auth (Google & GitHub OAuth)
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_SECRET=YOUR_GOOGLE_OAUTH_SECRET
GITHUB_OAUTH_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_OAUTH_SECRET=YOUR_GITHUB_OAUTH_SECRET

# Stripe (for payment processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
